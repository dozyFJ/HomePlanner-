<resources>
    <style name="HomePlannerTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:colorAccent">#087BB5</item>
        <item name="android:windowBackground">#EDF6FC</item>
        <item name="android:statusBarColor">#EDF6FC</item>
        <item name="android:navigationBarColor">#EDF6FC</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowOptOutEdgeToEdgeEnforcement">true</item>
    </style>
    <style name="HomePlannerDarkTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:colorAccent">#69C8FB</item>
        <item name="android:windowBackground">#101C2A</item>
        <item name="android:statusBarColor">#101C2A</item>
        <item name="android:navigationBarColor">#101C2A</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowOptOutEdgeToEdgeEnforcement">true</item>
    </style>
</resources>
